# Plantilla de configuración. Copiar a .env y completar: `cp .env.example .env && php artisan key:generate`.
# Valores pensados para producción; en desarrollo local cambiar APP_ENV=local, APP_DEBUG=true y LOG_LEVEL=debug.
# Auditoría de seguridad (docs/auditoria-seguridad.md, H-11): nunca APP_DEBUG=true en producción.

APP_NAME=SGIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=https://sgia.example.cl
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sgia
DB_USERNAME=sgia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# Orígenes del panel web y la app móvil, separados por coma. Sin valor no se acepta ningún origen.
CORS_ALLOWED_ORIGINS=https://sgia.example.cl
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (cotizaciones, avisos y reportes suscritos, docs/suscripcion-reportes.md). Con MAIL_MAILER=log los correos
# quedan en el log y «Mis suscripciones» avisa que el envío no está configurado.
# Desarrollo con Mailpit (`docker compose up -d mailpit`, bandeja en http://localhost:8025):
#   MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025, sin usuario ni contraseña.
# Producción: SMTP institucional (host, puerto 587, usuario y contraseña) o Amazon SES (MAIL_MAILER=ses con
# credenciales AWS). Los envíos necesitan `php artisan queue:work` y el cron de `php artisan schedule:run`.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# URL del panel web para los enlaces de los correos (por defecto APP_URL).
FRONTEND_URL=https://sgia.example.cl

# Lectura de facturas: textract (AWS) o local (pdftotext + Tesseract).
OCR_DRIVER=textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Contraseña del admin@sgia.cl sembrado por `php artisan migrate --seed`.
SEED_ADMIN_PASSWORD=
